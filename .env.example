# Optional host-side overrides when running compose from the project root.
# Preferred place for secrets in the lab is lab-data/.env

LLM_API_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=local
LLM_MODEL=Foundation-Sec-1.1-8B-Instruct
LLM_MAX_TOKENS=1200
# Lab-only escape hatch for self-signed providers; keep verification enabled otherwise.
# LLM_VERIFY_SSL=false
AGENT_WORKER_CONCURRENCY=4
AGENT_MAX_REQUESTS_PER_HOUR=120
FALSE_POSITIVE_THRESHOLD=0.90
INCIDENT_FINGERPRINT_KEY=lab-change-me
# Opt-in browser CORS (comma-separated). Empty = same-origin only (Compose UI proxy).
# CORS_ALLOW_ORIGINS=http://localhost:5173
