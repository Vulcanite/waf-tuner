POSTGRES_USER=waf
POSTGRES_PASSWORD=waf
POSTGRES_DB=wafdb
POSTGRES_HOST=127.0.0.1   # Use 127.0.0.1 for local system, 'postgres' for Docker
POSTGRES_PORT=5432
USE_LOCAL_NGINX=true

# LLM provider — OpenAI-compatible (set API_URL to https://openrouter.ai/api/v1 for OpenRouter)
API_KEY=sk-...
API_URL=https://api.openai.com/v1
API_MODEL=gpt-4o-mini

MODSEC_AUDIT_LOG=/var/log/modsec/audit.log
EVENTS_JSONL_PATH=./data/events.jsonl   # Use ./data/events.jsonl for local system, /app/data/events.jsonl for Docker
TRACKER_PATH=./data/tracker.json       # Use ./data/tracker.json for local system, /app/data/tracker.json for Docker
MODSEC_EXCEPTIONS_DIR=/etc/nginx/modsecurity/exceptions/
CRS_RULES_DIR=/etc/nginx/modsecurity/crs/rules/
NGINX_CONTAINER_NAME=nginx

TARGET_APP_HOST=target-app
TARGET_APP_PORT=5000
