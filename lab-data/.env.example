# Lab backend env (compose env_file for waf-tuner-backend).
# After editing: docker compose up -d --force-recreate waf-tuner-backend

# Generic OpenAI-compatible LLM (NVIDIA NIM, OpenAI, vLLM, …)
LLM_API_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
LLM_MODEL=z-ai/glm-5.2
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.01
LLM_REASONING_ENABLED=false
LLM_STRUCTURED_OUTPUT=false
# Lab-only escape hatch for self-signed providers; keep verification enabled otherwise.
# LLM_VERIFY_SSL=false

AGENT_WORKER_CONCURRENCY=4
AGENT_MAX_RETRIES=5
AGENT_MAX_REQUESTS_PER_HOUR=120
FALSE_POSITIVE_THRESHOLD=0.90
INCIDENT_FINGERPRINT_KEY=change-me-to-a-long-random-secret

# Structure-only (edge nginx -t not used)
RULE_VALIDATION_MODE=skip

# Require Application Context route before building FP exclusions (default: off)
# REQUIRE_APPLICATION_CONTEXT=true

# Opt-in browser CORS for bare-metal Vite (`npm run dev`). Leave unset in Compose.
# CORS_ALLOW_ORIGINS=http://localhost:5173
