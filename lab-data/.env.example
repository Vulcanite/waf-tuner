# Lab backend env (compose env_file for waf-tuner-backend).
# After editing: docker compose up -d --force-recreate waf-tuner-backend

# Generic OpenAI-compatible LLM (DeepSeek, OpenAI, vLLM, NVIDIA NIM, …)
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKEN=20000
LLM_TEMPERATURE=0.01
# Sent as {"thinking": {"type": ...}} and {"reasoning_effort": ...} (DeepSeek/OpenAI format).
# LLM_THINKING: enabled | disabled | off (off sends neither field, for providers that reject them).
# LLM_REASONING_EFFORT is sent only when thinking is enabled (DeepSeek: low, high, max).
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
# Try LLM_REASONING_EFFORT=low with an optional stronger request for uncertain results.
# LLM_ESCALATION_REASONING_EFFORT=high
LLM_STRUCTURED_OUTPUT=false
# Lab-only escape hatch for self-signed providers; keep verification enabled otherwise.
# LLM_VERIFY_SSL=false

AGENT_WORKER_CONCURRENCY=4
AGENT_MAX_RETRIES=5
AGENT_MAX_REQUESTS_PER_HOUR=120
FALSE_POSITIVE_THRESHOLD=0.90
INCIDENT_FINGERPRINT_KEY=change-me-to-a-long-random-secret
# Upper bound for the serialized evidence sent to the provider.
# AI_MAX_CONTEXT_BYTES=16384
# Local timezone used only when an audit timestamp has no offset.
# MODSEC_AUDIT_TIMEZONE=UTC
# Optional age limit for stored provider responses. Zero keeps the responses.
# INFERENCE_ARTIFACT_RETENTION_DAYS=30
# Optional age limit for raw SQLite audit evidence (settled cases).
# AUDIT_EVIDENCE_RETENTION_DAYS=30
# Optional size threshold for the audit mirror. One previous file is retained.
# EVENTS_JSONL_MAX_BYTES=104857600

# Require a matching Application Context route that describes the observed parameter (default).
# The seeded default-lab profile covers the documented DVWA routes.
# REQUIRE_APPLICATION_CONTEXT=false

# Opt-in browser CORS for bare-metal Vite (`npm run dev`). Leave unset in Compose.
# CORS_ALLOW_ORIGINS=http://localhost:5173
