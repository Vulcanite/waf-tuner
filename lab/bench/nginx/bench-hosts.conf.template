# Host routing for the benchmark apps. Mounted into every bench WAF at
# /etc/nginx/templates/conf.d/, so the image's envsubst step renders it.
# ModSecurity is on at http level (the image's conf.d/modsecurity.conf), so
# both servers are inspected by the same CRS rules and audit log.
#
# Host wp.bench -> WordPress, Host nc.bench -> Nextcloud. Any other Host hits
# the image's default_server block, which proxies to ${BACKEND} (WordPress).

server {
    listen ${PORT};
    server_name ${WP_SERVER_NAME};

    location / {
        client_max_body_size 0;
        set $wp_backend ${WP_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header Proxy "";
        proxy_set_header ${REAL_IP_PROXY_HEADER} $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_redirect off;
        proxy_pass $wp_backend;
    }
}

server {
    listen ${PORT};
    server_name ${NC_SERVER_NAME};

    location / {
        client_max_body_size 0;
        set $nc_backend ${NC_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header Proxy "";
        proxy_set_header ${REAL_IP_PROXY_HEADER} $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_redirect off;
        proxy_pass $nc_backend;
    }
}
